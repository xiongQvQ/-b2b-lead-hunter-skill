      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "unknowns": {
      "items": {
        "type": "string"
      },
      "title": "Unknowns",
      "type": "array"
    },
    "queries": {
      "items": {
        "$ref": "#/$defs/Query"
      },
      "title": "Queries",
      "type": "array"
    },
    "accounts": {
      "items": {
        "$ref": "#/$defs/AccountReview"
      },
      "title": "Accounts",
      "type": "array"
    },
    "contacts": {
      "items": {
        "$ref": "#/$defs/ContactReview"
      },
      "title": "Contacts",
      "type": "array"
    },
    "drafts": {
      "items": {
        "$ref": "#/$defs/Draft"
      },
      "title": "Drafts",
      "type": "array"
    }
  },
  "required": [
    "task_id",
    "input_hash",
    "expected_revision",
    "lease_token",
    "result_status"
