# Copy to .env in this skill directory. Never put actual keys in plans or chat.
# Absolute stable path OUTSIDE the installed skill directory; shared by all hosts.
LEAD_HUNTER_STATE_DIR=~/.local/share/b2b-lead-hunter
LEAD_HUNTER_MODE=live
LEAD_HUNTER_CONCURRENCY=4
LEAD_HUNTER_TIMEOUT=25
LEAD_HUNTER_MAX_RESPONSE_BYTES=2000000
# Global cumulative provider account budget for THIS local database, micro-USD.
LEAD_HUNTER_ACCOUNT_LIMIT_MICRO=10000000
SERPER_API_KEY=
JINA_API_KEY=
# Jev judge provider: typesafe (native typed API) | openrouter | openai_compatible.
JEV_PROVIDER=openrouter
# Generic Jev API key. When set, it overrides the provider-specific key below.
JEV_API_KEY=
TYPESAFE_API_KEY=
OPENROUTER_API_KEY=
# For openrouter, use your OpenRouter model slug; for typesafe, the Jev model name.
JEV_MODEL=jev-latest
# Empty = provider default. openai_compatible requires the full base URL.
# openrouter default: https://openrouter.ai/api/v1/chat/completions
# typesafe default: https://api.typesafe.ai/v1/systemone
JEV_BASE_URL=
TREG_TOKEN=
# Checked REST host is treg.to; do not substitute treg.io without verification.
TREG_BASE_URL=https://treg.to
# Per-request authorized cost ceilings, NOT price quotes. 0 means blocked.
# Confirm against your account price before enabling.
SERPER_CALL_CAP_MICRO=0
JINA_CALL_CAP_MICRO=0
JEV_CALL_CAP_MICRO=0
TREG_CALL_CAP_MICRO=0
# Accounting for Serper/Jina: set your confirmed fixed per-request charge.
# Jev actual usage remains unpriced unless reconciled manually from your bill.
SERPER_FIXED_COST_MICRO=
JINA_FIXED_COST_MICRO=
# Host fallback never happens silently. "host" is explicitly degraded operation.
JEV_FAILURE_POLICY=block
# Sending: optional for accounts/contacts/drafts. SMTP credentials never exported.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SENDER_EMAIL=
SENDER_NAME=David
SENDER_SIGNATURE=David
SENDER_POSTAL_ADDRESS=
UNSUBSCRIBE_LINE=If this is not relevant, reply "no" and I will not contact you again.
SENDER_TIMEZONE=Asia/Shanghai
SEND_DAILY_LIMIT=10
SEND_MIN_INTERVAL_SECONDS=60
CONTACT_POLICY=public_only
ALLOW_ROLE_EMAIL=false
